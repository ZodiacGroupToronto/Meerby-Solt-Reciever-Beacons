<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Meerby Solt Receiver — auto-updater and keep-alive. Checks GitHub every 5 min, restarts app on update. Runs as pc_script service account. No env var secrets.</Description>
    <URI>\Meerby-Solt(Updater&amp;KeepAlive)</URI>
  </RegistrationInfo>

  <Triggers>
    <!-- At boot, then repeat every 5 minutes indefinitely -->
    <BootTrigger>
      <Repetition>
        <Interval>PT5M</Interval>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
      <Delay>PT1M</Delay>
      <Enabled>true</Enabled>
    </BootTrigger>
    <!-- On registration (immediate first run after import) -->
    <RegistrationTrigger>
      <Repetition>
        <Interval>PT5M</Interval>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
      <Enabled>true</Enabled>
    </RegistrationTrigger>
  </Triggers>

  <Principals>
    <Principal id="Author">
      <UserId>pc_script</UserId>
      <LogonType>Password</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>

  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>

  <Actions Context="Author">
    <Exec>
      <Command>C:\ProgramData\MeerbyPCScript\app\Meerby-Solt-Reciever-Beacons-edge-computing-encryption\scripts\update_and_restart.bat</Command>
      <WorkingDirectory>C:\ProgramData\MeerbyPCScript</WorkingDirectory>
    </Exec>
  </Actions>
</Task>